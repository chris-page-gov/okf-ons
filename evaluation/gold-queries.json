{
  "schema": "okf-ons-evaluation-suite.v1",
  "suite_id": "okf-ons-confusable-dataset-selection",
  "title": "ONS confusable dataset discovery gold queries",
  "description": "A first-release deterministic suite for ranking the intended ONS dataset, exposing plausible alternatives, and presenting enough metadata evidence to compare them safely.",
  "version": "1.0.0",
  "defaults": {
    "cutoffs": [
      1,
      3,
      5,
      10
    ]
  },
  "statistical_accuracy_policy": {
    "evaluated": false,
    "statement": "This suite evaluates metadata retrieval, contrast, and evidence availability. It does not validate observations, estimates, methods, calculations, or statistical interpretations."
  },
  "curation": {
    "basis": [
      "MCP Geo ONS dataset-selection research",
      "OKF Explorer deterministic static-search evaluation pattern"
    ],
    "record_id_note": "Record IDs are curated canonical aliases and must be reconciled to the frozen OKF-ONS bundle IDs before a release gate is enabled."
  },
  "queries": [
    {
      "id": "ONS-Q001",
      "query": "UK inflation including owner occupiers' housing costs, monthly",
      "intent": "Find the CPIH dataset for the broadest official consumer inflation measure including owner occupiers' housing costs.",
      "stratum": "measure-definition",
      "why_confusing": "CPI, CPIH and RPI are all familiar inflation series but differ in population coverage, housing-cost treatment and status.",
      "target_record_id": "consumer-prices-cpih",
      "relevance": {
        "consumer-prices-cpih": 3
      },
      "alternatives": [
        {
          "record_id": "consumer-prices-cpi",
          "must_expose_by": 3,
          "reason": "CPI is a legitimate comparator but excludes owner occupiers' housing costs.",
          "contrast_fields": [
            "measure_concept",
            "housing_cost_treatment",
            "population_scope"
          ]
        },
        {
          "record_id": "retail-prices-index",
          "must_expose_by": 5,
          "reason": "RPI is widely searched for but has a different construction and official-use status.",
          "contrast_fields": [
            "measure_concept",
            "method",
            "official_status"
          ]
        }
      ],
      "required_evidence": [
        "title",
        "identity.dataset_id",
        "identity.edition",
        "identity.version",
        "provenance.source_url",
        "publication.release_date",
        "publication.revision_status",
        "statistical.measure",
        "statistical.unit",
        "statistical.population",
        "statistical.time_coverage",
        "statistical.frequency",
        "statistical.dimensions",
        "statistical.quality_notes"
      ],
      "required_standards": [
        "DCAT-AP",
        "SDMX",
        "ISO 8601",
        "PROV-O"
      ]
    },
