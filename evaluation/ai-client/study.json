  "run_contract": {
    "fresh_context_per_run": true,
    "arm_enforcement_values": ["enforced", "observed", "self-reported"],
    "readiness_outcomes": [
      "ready",
      "blocked",
      "manual-required",
      "not-probed"
    ],
    "task_statuses": [
      "completed",
      "degraded",
      "failed",
      "blocked",
      "not-run"
    ],
    "raw_exports_committed": false,
    "hidden_reasoning_collected": false,
    "comparative_runs_require_enforced_access": true,
    "access_enforcement_requires_evidence": true,
    "fault_profiles_require_enforcement_evidence": true,
    "efficiency_claims_require_comparative_arms": true,
    "missing_telemetry_remains_null": true,
    "ci_live_network": false,
    "ci_paid_calls": false
  },
  "primary_outcome": {
    "id": "safe-exact-selection",
    "definition": "The correct source-qualified target and required edition/version are selected, the exact record is hydrated when required, material caveats are retained and no critical unsupported claim is made.",
    "report_components_separately": true
  },
  "efficiency_outcomes": {
    "interpretation": "Efficiency is reported only alongside answer quality. A fast or cheap wrong selection is not an efficiency success.",
    "claim_rule": "A comparative efficiency claim requires the same task and host/model cell, enforced access arms, a declared denominator, and exact or explicitly qualified source measurements.",
    "measures": [
      {
        "id": "elapsed_time",
        "unit": "milliseconds",
        "scope": "task start to submitted visible structured answer"
      },
      {
        "id": "tool_calls",
        "unit": "calls",
        "scope": "all successful and failed calls by tool"
      },
      {
        "id": "response_bytes",
        "unit": "bytes",
        "scope": "complete and partial responses reported separately"
      },
      {
        "id": "provider_input_tokens",
        "unit": "tokens",
        "scope": "native provider telemetry only; null when not exposed"
      },
      {
        "id": "provider_output_tokens",
        "unit": "tokens",
        "scope": "native provider telemetry only; null when not exposed"
      },
      {
        "id": "selection_attempts",
        "unit": "attempts",
        "scope": "candidate reductions, comparisons and exact-record hydration attempts"
      },
      {
        "id": "provider_cost",
        "unit": "declared-currency",
        "scope": "provider-reported or tariff-derived with method and price date"
      }
    ],
    "single_composite_score": false
  },
  "confirmatory_extension": {
    "minimum_subject_reviewed_tasks": 50,
    "minimum_replicates_per_cell": 3,
    "paired_by_task": true,
    "randomised_order": true,
    "fresh_context_per_run": true,
    "gold_hidden_until_collection_frozen": true,
    "blind_human_assessors": 2,
    "adjudication_required": true,
    "report_host_and_model_combination": true,
    "causal_client_effect_claim_allowed": false,
    "stopping_rule": "Attempt every preregistered client, arm, task and replicate cell once; report readiness blocks separately."
  },
  "assurance_boundary": "Deterministic means assignment, capture, replay and scoring are repeatable. Model output is stochastic. The study evaluates metadata discovery behaviour, not statistical accuracy."
}
