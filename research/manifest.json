  "qualifications": [
    {
      "finding": "Claude F1",
      "status": "supported-for-orientation-only",
      "qualification": "Named entrypoints enabled efficient overview and standards orientation. Exact record hydration later required a guessed path, so the evidence does not establish a guess-free end-to-end journey."
    },
    {
      "finding": "Claude F2",
      "status": "hypothesis",
      "qualification": "The session reports caveat relay, but n=1 without a raw export or stripped-caveat control does not establish that the format caused the behaviour."
    },
    {
      "finding": "Claude F3",
      "status": "alignment-demonstration",
      "qualification": "The hydrated record supports an evidence-mapping demonstration. It is not independent DCAT, PROV-O, statistical-product or legal-compliance certification."
    },
    {
      "finding": "Claude F4",
      "status": "plausible-not-measured",
      "qualification": "Confusable alternatives and reconciliation were available, but the trace does not measure whether they reduce wrong selections."
    },
    {
      "finding": "Claude F5",
      "status": "confirmed-and-underestimated",
      "qualification": "Fetch truncation was real. Complete dataset chunks are approximately 5.2 to 6.8 MB, not the source document's estimated 0.5 MB. No declared canonical per-record hydration path exists."
    },
    {
      "finding": "Claude F6",
      "status": "confirmed-with-correction",
      "qualification": "The current search contract is browser-oriented and poorly documented for agents. Shards use deterministic token prefixes rather than hashes, and one flat index would itself exceed common fetch caps."
    },
    {
      "finding": "Claude F7",
      "status": "confirmed-client-and-contract-failures",
      "qualification": "Spooling recovered partial evidence; the browser failure was a client readiness issue, while the empty guessed URL exposed an undeclared hydration contract."
    },
    {
      "finding": "Claude F8",
      "status": "hypothesis",
      "qualification": "Token economics may be favourable, but the reported token range is estimated and returned partial bytes must not be described as full-resource bytes."
    },
    {
      "finding": "Claude F9",
      "status": "supported-for-one-session",
      "qualification": "Unauthenticated read-only HTTPS plus scratch storage was sufficient in this session. Required capabilities differ by client and must be probed."
    },
    {
      "finding": "Claude Appendix A call 28",
      "status": "corrected-inference",
      "qualification": "CPIH is present in the generated central MCP bindings file. The grep miss occurred because the client held only a truncated prefix of that multi-megabyte file."
    },
    {
      "finding": "Gemini resource efficiency",
      "status": "unsupported-conclusion",
      "qualification": "The session downloaded about 5.95 MB, exposed no exact provider-token telemetry and used no comparison arm. It demonstrates successful traversal, not high efficiency."
    },
    {
      "finding": "Gemini compliance checking",
      "status": "overclaim",
      "qualification": "The bundle registers and maps standards evidence. The trial did not independently test compliance, certification, statistical quality or legal obligations."
    },
    {
      "finding": "M365 exact bundle access",
      "status": "failed-and-disclosed",
      "qualification": "The Researcher output did not retrieve the supplied descriptor and therefore cannot support package-specific success or efficiency claims."
    },
    {
      "finding": "M365 hosting recommendation",
      "status": "architecture-proposal",
      "qualification": "This is an architecture proposal. Microsoft documentation supports the synced-versus-federated distinction, but neither the target tenant's custom-connector availability nor an OKF-ONS deployment was verified."
    }
  ],
